[1.235938, "o", "\u001b[1mdiff --git a/checkout.py b/checkout.py\u001b[m\r\n\u001b[1mindex 69f50e8..6a2f7e9 100644\u001b[m\r\n\u001b[1m--- a/checkout.py\u001b[m\r\n\u001b[1m+++ b/checkout.py\u001b[m\r\n\u001b[36m@@ -1,5 +1,6 @@\u001b[m\r\n \"\"\"Checkout totals in integer cents. Free shipping starts at a $50 original subtotal.\"\"\"\u001b[m\r\n def total(subtotal_cents, discount_percent):\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    original_subtotal = subtotal_cents\u001b[m\r\n     discounted = subtotal_cents * (100 - discount_percent) // 100\u001b[m\r\n\u001b[31m-    shipping = 0 if discounted >= 5000 else 599\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    shipping = 0 if original_subtotal >= 5000 else 599\u001b[m\r\n     return discounted + shipping\u001b[m\r\n"]
